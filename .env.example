# Public site URL for Open Graph / social sharing (recommended on Vercel for stable link previews)
NEXT_PUBLIC_SITE_URL=https://weekly-funded-companies-agent.vercel.app

GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override primary model (falls back to gemini-2.5-flash-lite, gemini-3.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: landing page demo video (MP4 path or YouTube/Loom URL)
# NEXT_PUBLIC_DEMO_VIDEO_URL=/demo.mp4
# Optional: poster image for instant thumbnail (defaults to /demo-poster.jpg for /demo.mp4)
# NEXT_PUBLIC_DEMO_VIDEO_POSTER_URL=/demo-poster.jpg

# Google Apps Script Web App URL to append feedback rows into Google Sheets
# GOOGLE_SHEETS_FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
